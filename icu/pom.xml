<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.pharaphara.raceradio</groupId>
    <artifactId>race-radio-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>race-radio-icu</artifactId>
  <name>race-radio-icu</name>
  <description>Intervals.icu client: reads, guarded writes, dry-run and workout syntax validation.</description>

  <!--
    The HTTP client is the JDK's own java.net.http, so this module needs no framework: only
    Jackson to read and write JSON. It can be reused by anyone who wants a small, honest
    Intervals.icu client without pulling Spring in.
  -->
  <dependencies>
    <dependency>
      <groupId>io.github.pharaphara.raceradio</groupId>
      <artifactId>race-radio-core</artifactId>
    </dependency>
    <!--
      Jackson 3. The group and the root package moved (tools.jackson), the annotations stayed at
      com.fasterxml.jackson.annotation. Spring Boot 4 ships this version; two Jacksons side by side
      would be a needless trap once the bot module arrives.
    -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
