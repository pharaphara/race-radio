<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.pharaphara.raceradio</groupId>
    <artifactId>race-radio-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>race-radio-bot</artifactId>
  <name>race-radio-bot</name>
  <description>The running service: Telegram, scheduling, the language model, the ledger and the journal.</description>

  <properties>
    <anthropic-java.version>2.34.0</anthropic-java.version>
    <sqlite-jdbc.version>3.50.3.0</sqlite-jdbc.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.pharaphara.raceradio</groupId>
      <artifactId>race-radio-icu</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>io.github.pharaphara.raceradio</groupId>
      <artifactId>race-radio-charts</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- The official Anthropic SDK. Every call goes through one class, which records it. -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>${anthropic-java.version}</version>
    </dependency>

    <!--
      SQLite: one file, no server, backed up with the container. The history of decisions,
      conversations and model calls is small and written by a single process.
    -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Default resource root, restated because declaring <resources> replaces it. -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!--
        The knowledge base lives at the repository root, readable without opening the code, and is
        copied onto the classpath at build time rather than duplicated.
      -->
      <resource>
        <directory>${project.basedir}/../knowledge</directory>
        <targetPath>knowledge</targetPath>
        <includes>
          <include>*.md</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
