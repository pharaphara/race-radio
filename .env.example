# Copy to .env (ignored by git and by the Docker build) and fill in.

# Intervals.icu -> Settings -> Developer settings -> API key.
INTERVALS_ATHLETE_ID=
INTERVALS_API_KEY=

# @BotFather gives the token. The chat id: send the bot a message, then read
# https://api.telegram.org/bot<token>/getUpdates and take message.chat.id.
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# How the coach reaches its model. subscription: a Claude subscription through the Claude Code
# command line; run "claude setup-token" once and paste the token. api: the Anthropic API, billed per
# token. Set one of the two credentials, not both.
RACE_RADIO_MODEL_TRANSPORT=subscription
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Or any service speaking the OpenAI chat format: openai, with OpenRouter unless a base URL is given
# (https://api.openai.com/v1, https://api.mistral.ai/v1, http://ollama:11434/v1 ...), and the model
# by its name there. The coach's figures are computed either way; only the wording changes.
# RACE_RADIO_MODEL_TRANSPORT=openai
# RACE_RADIO_MODEL=<model name, e.g. vendor/model:free on OpenRouter>
# RACE_RADIO_MODEL_BASE_URL=
# RACE_RADIO_MODEL_API_KEY=

# Optional: a second model asked when the first fails, is out of quota or declines, for instance a
# free model first and the Claude subscription behind it.
# RACE_RADIO_MODEL_FALLBACK_TRANSPORT=subscription
# RACE_RADIO_MODEL_FALLBACK=claude-sonnet-5-5
# Answers from such a model are checked: a number absent from the facts, or an explanation the
# knowledge base rejects, refuses the answer and the fallback writes it (enforce), or is only
# logged (report), or not checked (off).
# RACE_RADIO_MODEL_GUARD=enforce
# Reviews and answers as JSON whose figures are references to the facts, filled in by the program:
# a model then cannot compute or invent a figure. Helps smaller models; Claude does not need it.
# RACE_RADIO_PROMPT_FORMAT=json

# Optional: to invite other athletes (/inviter). Seals the Intervals.icu keys they give at check-in.
# Make one with: openssl rand -base64 32. Keep it: without it, their keys cannot be opened.
# RACE_RADIO_SECRET_KEY=

# Nothing is written to Intervals.icu until this is false.
RACE_RADIO_DRY_RUN=true

# Or open writes one kind at a time, the others staying a dry run:
# workouts, notes, comments, intervals, merge, or all. Overrides RACE_RADIO_DRY_RUN.
# RACE_RADIO_WRITES=workouts

# Optional: critical swim speed in seconds per 100 m from a 400 m / 200 m test, when the
# Intervals.icu profile's swim threshold is a guess.
# RACE_RADIO_SWIM_CSS=

# Optional: a personal Strava API app (https://www.strava.com/settings/api, callback domain
# "localhost"), to keep every segment crossed and its trace before a subscription ends.
# The refresh token comes from authorising the app once with the scope
# read,activity:read_all,profile:read_all; see README.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REFRESH_TOKEN=

# Optional: when the current heart-rate strap came into use (YYYY-MM-DD). Heart-rate trends flag the
# months before it, recorded with another strap.
# RACE_RADIO_HR_STRAP_SINCE=
