# Copy to .env (ignored by git and by the Docker build) and fill in.

# Intervals.icu -> Settings -> Developer settings -> API key.
INTERVALS_ATHLETE_ID=
INTERVALS_API_KEY=

# @BotFather gives the token. The chat id: send the bot a message, then read
# https://api.telegram.org/bot<token>/getUpdates and take message.chat.id.
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# How the coach reaches Claude. subscription: a Claude subscription through the Claude Code command
# line; run "claude setup-token" once and paste the token. api: the Anthropic API, billed per token.
# Set one of the two credentials, not both.
RACE_RADIO_MODEL_TRANSPORT=subscription
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Nothing is written to Intervals.icu until this is false.
RACE_RADIO_DRY_RUN=true

# Optional: critical swim speed in seconds per 100 m from a 400 m / 200 m test, when the
# Intervals.icu profile's swim threshold is a guess.
# RACE_RADIO_SWIM_CSS=
